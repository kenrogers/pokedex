{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Public BYOK deploy: static files only. No Worker code runs, so there is no CPU limit to hit.
  "name": "dex-open",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "dist",
    "not_found_handling": "single-page-application"
  }
}
