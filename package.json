{
  "name": "dex-open",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p worker/tsconfig.json",
    "deploy": "vite build && wrangler deploy",
    "build:private": "VITE_SERVER_PROXY=1 vite build",
    "deploy:private": "VITE_SERVER_PROXY=1 vite build && wrangler deploy -c wrangler.private.jsonc"
  },
  "dependencies": {
    "@openuidev/lang-core": "^0.4.0",
    "@openuidev/react-lang": "^0.4.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261006.1",
    "@tailwindcss/vite": "^4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "^7",
    "wrangler": "^4.149.0"
  },
  "license": "MIT"
}
