{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Private deploy that pays with YOUR key. Build with VITE_SERVER_PROXY=1 (npm run deploy:private).
  // Secrets: npx wrangler secret put OPENROUTER_API_KEY -c wrangler.private.jsonc
  //          npx wrangler secret put ACCESS_PASSWORD   -c wrangler.private.jsonc
  "name": "dex-private",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["global_fetch_strictly_public"],
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "observability": { "enabled": true },
  "ratelimits": [
    { "name": "RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 30, "period": 60 } }
  ],
  "vars": {
    // Must match the models in src/core/config.ts (or your VITE_* overrides).
    "ALLOWED_MODELS": "openai/gpt-6-luna,openai/whisper-large-v3,elevenlabs/eleven-v4-turbo,google/gemini-nano-banana-2.1"
  }
}
